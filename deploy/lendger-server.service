# systemd unit for running the jar directly (see docs/operator/install.md).
# Install: copy to /etc/systemd/system/, create the user and folders, edit the paths, then
#   systemctl daemon-reload && systemctl enable --now lendger-server
[Unit]
Description=Lendger server
After=network-online.target
Wants=network-online.target

[Service]
User=lendger
Group=lendger
# Settings live in /etc/lendger/lendger.env (one NAME=value per line); see docs/operator/install.md.
EnvironmentFile=/etc/lendger/lendger.env
ExecStart=/usr/bin/java -Xmx256m -jar /opt/lendger/lendger-server.jar serve
Restart=on-failure
RestartSec=5

# The server only needs its own data folder and the backup folder.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
ReadWritePaths=/var/lib/lendger /srv/lendger-backups
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
